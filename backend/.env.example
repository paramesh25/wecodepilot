# Copy to .env and fill in. NEVER commit .env.
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Moodle running in Docker Desktop
MOODLE_URL=http://localhost:8000
# Token of the admin/integration web-service user ("Academy Integration" service)
MOODLE_TOKEN=
# SHORT NAME of the service learners use at login/token.php (not the display name)
MOODLE_LOGIN_SERVICE=

# Long random string:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
